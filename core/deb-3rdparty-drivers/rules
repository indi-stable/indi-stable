#!/usr/bin/make -f
#
# Debian build for indi-stable-3rdparty-drivers. Mirrors
# core/rpm/indi-stable-3rdparty-drivers.spec -- same private prefix, same 9
# vendor drivers plus eqmod, same 47-entry WITH_<X>=OFF scope list, same
# CFLAGS fix and toupcam_test/omegonprocam_test patch. Read that spec's
# header and %%build comments for the full rationale; this file carries only
# the Debian-specific mechanics. core/deb-3rdparty-libs/rules is the sibling
# this package Build-Depends and Depends on.
#
# eqmod (added 2026-09-08) needs NO debian/shlibs.local entry of its own,
# unlike every vendor driver here: the only private libraries it links are
# core's libindidriver and libindiAlignmentDriver, both already listed there,
# and its other two dependencies (libnova, libgsl) are ordinary distribution
# packages that ship real shlibs files, so ${shlibs:Depends} resolves them
# with no help from us.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

INDI_PREFIX := /opt/indi-stable
INDI_LIBDIR := $(INDI_PREFIX)/lib
INDI_INCLUDEDIR := $(INDI_PREFIX)/include
INDI_BINDIR := $(INDI_PREFIX)/bin
INDI_DATADIR := $(INDI_PREFIX)/share/indi

%:
	dh $@ --buildsystem=cmake

# -DINDI_DATA_DIR is PINNED, not discovered, and that is load-bearing.
# Nothing in indi-3rdparty ever assigns it -- FindINDI.cmake only documents
# the name -- yet it turns up in CMakeCache as a PATH resolved from the build
# host. On a machine with the distribution's libindi-data installed it came
# out /usr/share/indi, and every catalogue except eqmod's (which sets its own
# from CMAKE_INSTALL_PREFIX) installed OUTSIDE the private prefix. The Fedora
# mock chroot has no libindi-data, so the same spec silently got it right
# there. Same class of defect as WITH_WEBCAM/WITH_NUT in DESIGN.md: an
# install path decided by what happens to be installed on the build machine.
override_dh_auto_configure:
	# toupcam_test and omegonprocam_test are vendor SDK diagnostic tools, not
	# INDI drivers -- neither has an install() rule in
	# indi-toupbase/CMakeLists.txt, so they were never going to be packaged
	# regardless. ninja builds cmake's default "all" target though, and
	# omegonprocam_test.cpp fails to compile outright (an upstream
	# include-path bug this project has no need to chase down, since the
	# file was never wanted) -- see core/rpm's own %%prep comment for the
	# full finding. EXCLUDE_FROM_ALL keeps both out of the default build
	# without touching the add_executable()/target_link_libraries() blocks
	# themselves. Both add_executable() lines are indented (inside their
	# WITH_<BRAND>CAM if() blocks), so the sed match must not anchor to
	# column 1.
	sed -i '/add_executable(toupcam_test /a set_target_properties(toupcam_test PROPERTIES EXCLUDE_FROM_ALL TRUE)' indi-toupbase/CMakeLists.txt
	sed -i '/add_executable(omegonprocam_test /a set_target_properties(omegonprocam_test PROPERTIES EXCLUDE_FROM_ALL TRUE)' indi-toupbase/CMakeLists.txt
	# Extra -I$(INDI_INCLUDEDIR): indi-apogee/apogee_ccd.cpp mixes
	# `#include "Alta.h"` (unqualified, resolved fine by the vendor
	# find_package()'s own include dir) and `#include <libapogee/Alta.h>`
	# (qualified, needs the PARENT directory on the search path instead)
	# for the SAME header -- see core/rpm's own %%build comment for the full
	# finding. Exported globally rather than patching the one file, since
	# the same upstream inconsistency is plausible elsewhere.
	CFLAGS="$$CFLAGS -I$(INDI_INCLUDEDIR)" CXXFLAGS="$$CXXFLAGS -I$(INDI_INCLUDEDIR)" \
	dh_auto_configure -- \
		-DCMAKE_INSTALL_PREFIX=$(INDI_PREFIX) \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_RPATH=$(INDI_LIBDIR) \
		-DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON \
		-DINDI_ROOT=$(INDI_PREFIX) \
		-DINDI_DATA_DIR=$(INDI_DATADIR) \
		-DCMAKE_PREFIX_PATH=$(INDI_PREFIX) \
		-DBUILD_LIBS=OFF \
		-DWITH_ASTROASIS=OFF \
		-DWITH_ATIK=OFF \
		-DWITH_QHY=OFF \
		-DWITH_SVBONY=OFF \
		-DWITH_PENTAX=OFF \
		-DWITH_QSI=OFF \
		-DWITH_ASTARBOX=OFF \
		-DWITH_ASTROLINK4=OFF \
		-DWITH_ASTROMECHFOC=OFF \
		-DWITH_AVALONUD=OFF \
		-DWITH_BEEFOCUS=OFF \
		-DWITH_BRESSEREXOS2=OFF \
		-DWITH_DREAMFOCUSER=OFF \
		-DWITH_DSI=OFF \
		-DWITH_DUINO=OFF \
		-DWITH_FFMV=OFF \
		-DWITH_GPHOTO=OFF \
		-DWITH_GPIO=OFF \
		-DWITH_GPSD=OFF \
		-DWITH_GPSNMEA=OFF \
		-DWITH_LIMESDR=OFF \
		-DWITH_MGEN=OFF \
		-DWITH_RADIOSIM=OFF \
		-DWITH_ROLLOFFINO=OFF \
		-DWITH_RTKLIB=OFF \
		-DWITH_SHELYAK=OFF \
		-DWITH_SPECTRACYBER=OFF \
		-DWITH_STARBOOK=OFF \
		-DWITH_SX=OFF \
		"-DWITH_TICFOCUSER-NG=OFF" \
		-DWITH_WEEWX_JSON=OFF \
		-DWITH_WEBCAM=OFF \
		-DWITH_NUT=OFF

override_dh_auto_install:
	dh_auto_install
	# --- vendor SDK test/bench utilities: not INDI drivers, not packaged ---
	rm -f debian/tmp$(INDI_BINDIR)/asi_camera_test
	rm -f debian/tmp$(INDI_BINDIR)/asi_multi_camera_test
	rm -f debian/tmp$(INDI_BINDIR)/asi_camera_bench
	rm -f debian/tmp$(INDI_BINDIR)/asi_wheel_test
	rm -f debian/tmp$(INDI_BINDIR)/playerone_camera_test
	rm -f debian/tmp$(INDI_BINDIR)/playerone_camera_bench
	# Same class: a standalone CLI test tool upstream install()s, in no
	# catalogue and not an INDI driver. See core/rpm's %%install.
	rm -f debian/tmp$(INDI_BINDIR)/aagcloudwatcher_test_ng
	# --- udev rules: re-home under a namespaced filename --------------------
	# NEW with the armadillo-platypus slice. Until then nothing in THIS source
	# package shipped a udev rule -- every rule this project installed came
	# from core/deb-3rdparty-libs, whose rules file redirects
	# UDEVRULES_INSTALL_DIR with a -D and re-homes out of that private
	# directory.
	#
	# That approach does not work here, and the RPM side's first build is what
	# proved it. Every lib* vendor directory declares UDEVRULES_INSTALL_DIR as
	# set(... CACHE STRING ...), so a -D override wins. Five DRIVER
	# directories -- armadillo-platypus, dsi, orion-ssg3, qsi, sx -- instead
	# use RULES_INSTALL_DIR, hardcoded by a plain set() with no CACHE, which
	# overwrites the command line at configure time. Neither -D can move them.
	# So the rule installs itself straight to a hardcoded /usr/lib/udev/rules.d
	# under upstream's own filename -- the exact name a distribution package
	# for the same hardware owns. See DESIGN.md, "Upstream build-system facts".
	#
	# Re-home by DESTINATION rather than by source directory, which is robust
	# to both upstream mechanisms. /usr/lib, not /lib: merged-usr.
	mkdir -p debian/tmp/usr/lib/udev/rules.d
	set -e; for rule in debian/tmp$(INDI_PREFIX)/udev-rules/*.rules \
	                    debian/tmp/usr/lib/udev/rules.d/*.rules; do \
		[ -e "$$rule" ] || continue; \
		base=$$(basename "$$rule"); \
		case "$$base" in *-indi-stable-3rdparty-*) continue ;; esac; \
		mv "$$rule" "debian/tmp/usr/lib/udev/rules.d/$${base%%-*}-indi-stable-3rdparty-$${base#*-}"; \
	done
	rm -rf debian/tmp$(INDI_PREFIX)/udev-rules
	# A loop that finds nothing must not pass as though it worked (#1).
	# Exactly one driver in scope ships a rule; maxdomeii deliberately ships
	# none, so assert a COUNT, not "at least one".
	# Four drivers in scope ship one rule each, by THREE different upstream
	# mechanisms -- a CACHE variable (nightscape), a plain set() no -D can
	# move (armadillo-platypus, orion-ssg3), and a literal path with no
	# variable at all (openogma). That is why the loop above keys on
	# destination. Asserting the COUNT makes a fifth fail here with an
	# explanation rather than later as an uninstalled file.
	set -e; n=$$(ls -1 debian/tmp/usr/lib/udev/rules.d/*.rules 2>/dev/null | wc -l); \
	test "$$n" -eq 4 \
		|| { echo "ERROR: expected exactly 4 udev rules, found $$n:"; ls -1 debian/tmp/usr/lib/udev/rules.d/ 2>/dev/null; exit 1; }
	set -e; for r in armadilloplatypus nightscape openogma orionssg3; do \
		test -e debian/tmp/usr/lib/udev/rules.d/99-indi-stable-3rdparty-$$r.rules \
			|| { echo "ERROR: the $$r rule is not at its re-homed name"; ls -1 debian/tmp/usr/lib/udev/rules.d/; exit 1; }; \
	done
	# Nothing may be left at an upstream filename. This is the coexistence
	# assertion, and the one the RPM side's first build failed.
	set -e; bare=$$(ls -1 debian/tmp/usr/lib/udev/rules.d/*.rules 2>/dev/null | grep -v -- '-indi-stable-3rdparty-' || true); \
	test -z "$$bare" \
		|| { echo "ERROR: udev rules left at an upstream filename, where a distro rule belongs:"; echo "$$bare"; exit 1; }
	# --- eqmod: drop the catalogue entry for the driver we do not build -----
	# indi_eqmod.xml catalogues indi_ahpgt_telescope, which indi-eqmod's own
	# local option(WITH_AHP_GT ... OFF) means we never build. Left alone it
	# would survive the rewrite below as a BARE name, and a bare name is
	# strictly worse than a missing entry: indiserver resolves it through
	# PATH, so a distribution indi_ahpgt_telescope would be what actually ran
	# out of OUR catalogue. See core/rpm's %%install for the full finding;
	# the count assertion is LESSONS_LEARNED.md #1.
	set -e; \
	cat=debian/tmp$(INDI_DATADIR)/indi_eqmod.xml; \
	before=$$(grep -c 'indi_ahpgt_telescope' "$$cat"); \
	test "$$before" -eq 1 \
		|| { echo "ERROR: expected exactly 1 indi_ahpgt_telescope catalogue entry, found $$before -- indi_eqmod.xml.cmake changed upstream"; exit 1; }; \
	sed -i '/<device label="AHP GT Mount"/,/<\/device>/d' "$$cat"; \
	if grep -q 'indi_ahpgt_telescope' "$$cat"; then \
		echo "ERROR: indi_ahpgt_telescope still present after the device-block delete"; exit 1; \
	fi; \
	for d in indi_eqmod_telescope indi_azgti_telescope \
	         indi_staradventurergti_telescope indi_staradventurer2i_telescope; do \
		grep -q "$$d" "$$cat" \
			|| { echo "ERROR: $$d lost from indi_eqmod.xml -- the AHP GT delete over-matched"; exit 1; }; \
	done
	# --- driver catalogue: absolute paths, not bare names -------------------
	# Same defect, same fix, same verification method as core/deb/rules --
	# see that file's comment for the full reasoning (DESIGN.md,
	# "Driver-manifest discoverability"). indi-3rdparty does not emit ONE
	# drivers.xml the way core does, it emits one indi_<vendor>.xml PER
	# vendor (11 separate indi_<brand>.xml files for touptek alone), so this
	# loops over every catalogue file this package installs.
	set -e; \
	sedf=$$(mktemp); \
	for b in debian/tmp$(INDI_BINDIR)/*; do \
		[ -f "$$b" ] && [ -x "$$b" ] || continue; \
		n=$$(basename "$$b"); \
		echo "s|>$$n</driver>|>$(INDI_BINDIR)/$$n</driver>|g" >> "$$sedf"; \
	done; \
	n_done=0; \
	for cat in debian/tmp$(INDI_DATADIR)/indi_*.xml; do \
		[ -e "$$cat" ] || continue; \
		sed -i -f "$$sedf" "$$cat"; \
		n=$$(grep -c ">$(INDI_BINDIR)/" "$$cat") || n=0; \
		n_done=$$(( n_done + n )); \
	done; \
	rm -f "$$sedf"; \
	test "$$n_done" -gt 0 || { echo "ERROR: rewrote 0 catalogue entries across every indi_*.xml; the <driver> form changed upstream"; exit 1; }; \
	echo "driver catalogues: rewrote $$n_done entries to $(INDI_BINDIR)"
	# Every <driver> entry must now name an absolute path. Any that does not is
	# a catalogue entry for a binary this package did not build, and would
	# resolve through PATH to whatever the distribution provides -- the AHP GT
	# case stripped above, found 2026-09-08 while adding eqmod, generalized so
	# the next one cannot arrive silently. Verified non-vacuous before being
	# relied on: all 56 entries in the already-shipped 2.2.4.1-1 debs were
	# already absolute, and against an unstripped indi_eqmod.xml it fires.
	set -e; \
	bare=$$(grep -hoE '<driver[^>]*>[^<]+</driver>' debian/tmp$(INDI_DATADIR)/indi_*.xml \
	        | grep -vE ">$(INDI_BINDIR)/" || true); \
	if [ -n "$$bare" ]; then \
		echo "ERROR: catalogue entries left as bare names, which resolve via PATH to a distro binary:"; \
		echo "$$bare"; \
		exit 1; \
	fi
	# Assert every vendor this package means to ship actually landed, rather
	# than trusting a clean cmake build exit (LESSONS_LEARNED.md #1 and #5).
	# All four eqmod binaries are listed, not one representative: they are four
	# separate add_executable() targets whose only shared fate is skywatcher.cpp,
	# so any one of them can go missing on its own.
	set -e; for bin in indi_apogee_ccd indi_asi_ccd indi_fli_ccd indi_playerone_ccd \
	                   indi_inovaplx_ccd indi_mi_ccd indi_sbig_ccd indi_toupcam_ccd \
	                   indi_fishcamp_ccd indi_eqmod_telescope indi_azgti_telescope \
	                   indi_staradventurergti_telescope indi_staradventurer2i_telescope \
	                   indi_armadillo_focus indi_platypus_focus indi_seletek_rotator \
	                   indi_dragonfly indi_dragonfly_dome indi_beaver_dome \
	                   indi_maxdomeii indi_lx200aok indi_lx200stargo \
	                   indi_celestron_aux indi_nexdome indi_talon6 indi_ocs \
	                   indi_starbook_ten indi_aagcloudwatcher_ng \
	                   indi_nightscape_ccd indi_openogma \
	                   indi_orion_ssg3_ccd indi_atik_efw; do \
		test -x debian/tmp$(INDI_BINDIR)/$$bin \
			|| { echo "ERROR: $$bin did not install -- an upstream WITH_* default or driver name changed"; exit 1; }; \
	done

# Skipped entirely, same "do not advertise a private library system-wide"
# reason as core/deb/rules and core/deb-3rdparty-libs/rules -- these
# binaries do not themselves ship libraries, but dh_makeshlibs would still
# try to process anything .so-shaped it finds and there is nothing here that
# should ever get a shlibs/symbols file.
override_dh_makeshlibs:

# UNLIKE core/deb-3rdparty-libs/rules, this package genuinely needs
# debian/shlibs.local: every driver binary links against BOTH core's
# libindi* (from indi-stable-core-libs) AND a vendor library (from
# indi-stable-3rdparty-libs-<vendor>) -- both installed on the build host
# via Build-Depends, both real files findable through RPATH, and NEITHER
# ships a shlibs file of its own (both upstream packages skip
# dh_makeshlibs, same reasoning as this one). dpkg-shlibdeps finds the
# files but has no dependency information for either without
# shlibs.local -- DESIGN.md's "The Debian half of the metadata layer"
# predicted exactly this package would need it, where
# indi-stable-3rdparty-libs itself did not (checked directly: none of its
# own libraries link against anything private).
#
# No override_dh_shlibdeps -l needed here, unlike core/deb/rules: core's -l
# points dh_shlibdeps at core's OWN just-built, not-yet-installed libraries
# staged in debian/tmp. Here, both dependency sources (core-libs and every
# -libs vendor package) are ALREADY REALLY INSTALLED on the build host by
# the time this package builds (they are Build-Depends, not siblings built
# in the same tree), so RPATH resolution finds the real files directly;
# debian/shlibs.local supplies the missing dependency information dpkg-
# shlibdeps consults automatically, with no extra flag required.
