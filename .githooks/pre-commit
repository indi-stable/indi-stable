#!/bin/bash
#
# Pre-commit: run the mechanical doc-staleness checks against the tree being
# committed.
#
# WHY THIS LIVES IN .githooks AND NOT .git/hooks
#
# .git/hooks is not version controlled, so a hook installed there exists on one
# clone and nowhere else. This project is worked on from two machines that are
# explicitly kept in sync (STATUS.md), and a check that silently does not run on
# the other one is the same class of problem the checker exists to catch. Keeping
# the hook in the repo means both clones get it from a pull; each needs the
# one-time
#
#     git config core.hooksPath .githooks
#
# WHY THE STAGED TREE AND NOT THE WORKING TREE
#
# They differ whenever a commit is staged selectively, and the dangerous
# direction is silent: staged content stale, working tree already fixed, hook
# passes, stale content lands. So the staged tree is extracted and checked on
# its own -- including the copy of the checker being committed, which is the
# version that will be in the repo afterwards.
#
# To bypass deliberately: git commit --no-verify
#
set -u

TMP=$(mktemp -d /tmp/precommit-docs.XXXXXX)
cleanup() { rm -rf "$TMP"; }
trap cleanup EXIT

# The staged tree, exactly as it will be committed.
if ! git checkout-index -a -f --prefix="$TMP/" 2>/dev/null; then
  echo "pre-commit: could not extract the staged tree; skipping doc checks." >&2
  exit 0
fi

CHECKER=$TMP/scripts/check-docs.sh
if [ ! -f "$CHECKER" ]; then
  # A commit that removes or renames the checker must not fail on its absence.
  echo "pre-commit: scripts/check-docs.sh not in the staged tree; skipping doc checks."
  exit 0
fi

OUT=$(bash "$CHECKER" --quiet "$TMP" 2>&1)
RC=$?
if [ "$RC" -eq 0 ]; then
  exit 0
fi

echo
echo "$OUT"
echo
echo "pre-commit: the doc checks above failed against the STAGED tree."
echo "  Fix the findings and re-stage, or bypass with:  git commit --no-verify"
echo "  Note these are mechanical checks only -- stale PROSE is not detected."
exit 1
